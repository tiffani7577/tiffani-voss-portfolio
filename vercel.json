{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/public" }
    }
  ],
  "rewrites": [
    {
      "source": "/portfolio.html",
      "destination": "/portfolio.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
